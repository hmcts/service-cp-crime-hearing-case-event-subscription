ContainerLogV2
| where PodNamespace  == 'ns-dev-amp-01'
| where TimeGenerated > ago(1d)
| where ContainerName != 'istio-proxy'
| where PodName contains 'hearing-results'
| where LogMessage contains 'getDocument request'
| project TimeGenerated, LogLevel, LogMessage
| make-series GetDocument = count() default=0
    on TimeGenerated
    from ago(1d) to now()
    step 1h
| render columnchart
