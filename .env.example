# Template for the local .env used by EntraTokenValidationApiTest (apiTest subproject).
#
#   cp .env.example .env          # .env and .envrc are already git-ignored
#   printf 'dotenv\n' > .envrc    # tells direnv to load .env
#   direnv allow
#
# Fill in the two credential values below; the rest have working dev defaults.
# NEVER commit .env — it holds a client secret.

# --- credentials: no defaults, required ---------------------------------------
# The calling application's registration in the ISSUING tenant, and its secret.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- the issuing tenant and this API's audience -------------------------------
# Defaults are dev. For SIT the same pair applies; prd must be confirmed.
# This is the tenant that ISSUES tokens, not the one the service is deployed in.
ENTRA_TENANT_ID=e2995d11-9947-4e78-9de6-d44e0603518e
ENTRA_AUDIENCE=bff71afb-9651-445e-bec7-158796787815

# --- the service under test ---------------------------------------------------
# Local:    http://localhost:8082
# Deployed: https://<ingress-host>/hrds   <- include the /hrds route prefix
#
# Go direct to the ingress, not through APIM: APIM validates tokens itself, so a bad token is
# rejected at the gateway and never reaches the service — the test would pass while proving nothing.
SERVICE_BASE_URL=http://localhost:8082

# Only when SERVICE_BASE_URL points at APIM rather than the ingress. Leave blank otherwise.
SERVICE_SUBSCRIPTION_KEY=

# --- TLS ------------------------------------------------------------------------
# Internal ingress hosts serve certificates from a private CA that
# no JDK ships, so the handshake would fail with "PKIX path building failed". Skip verification
# instead of maintaining a truststore -- the curl -k equivalent.
#
# This applies ONLY to the call to the service under test. The Entra token request keeps full
# verification because it carries the client secret. Refused outright against a live-looking host.
SERVICE_TLS_INSECURE=true

# Must match how the service was started: OFF | OBSERVE | ENFORCE.
# Under OFF and OBSERVE an invalid token is allowed through, and the test expects that.
# Deployed environments are always ENFORCE — the startup guard refuses anything else.
SERVICE_AUTH_MODE=ENFORCE
